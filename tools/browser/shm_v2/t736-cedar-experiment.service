[Unit]
Description=T736 isolated Cedar ordinary-RAM transport experiment
After=local-fs.target
Requires=t736-cedar.socket
After=t736-cedar.socket
ConditionPathExists=/dev/cedar_dev

[Service]
Type=simple
User=t736-cedar
Group=t736
UMask=0007
ExecStart=/opt/t736-cedar-transport-v2/bin/cedar-service
Restart=no
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/cedar_dev rw
DeviceAllow=/dev/dma_heap/t736-ve rw
MemoryMax=512M
TasksMax=64
CPUAffinity=6 7
PrivateMounts=yes
BindReadOnlyPaths=/opt/t736-cedar-transport-v2/config/cedarc.conf:/etc/cedarc.conf

# Deliberately no Install section: start explicitly after the native RAM tests.
