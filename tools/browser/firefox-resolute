#!/bin/sh
# Launch the AtlasA1 Firefox profile with the Cedar codec built for libavcodec62.
set -eu
lib=/opt/atlasa1-firefox/lib
profile=${T736_CEDAR_PROFILE:-${HOME}/.mozilla/atlasa1-cedar}
mkdir -p -- "$profile"
pref='user_pref("dom.ipc.forkserver.enable", false);'
if ! grep -Fqx "$pref" "$profile/user.js" 2>/dev/null; then
    printf '\n%s\n' "$pref" >> "$profile/user.js"
fi
unset T736_CEDAR_TEST_CLIENT T736_CEDAR_NATIVE_PLAYER
export T736_CEDAR_ENABLE=1
gpu=/opt/t736-img-ddk-24.2-x11
lookup=
if [ "${XDG_SESSION_TYPE:-}" = wayland ] && [ -n "${WAYLAND_DISPLAY:-}" ] &&
   [ -r /opt/atlasa1-img-wayland/runtime-gles/libEGL.so.1 ] &&
   [ -r /opt/atlasa1-img-wayland/firefox-gles/libGL.so.1 ]; then
    gpu=/opt/atlasa1-img-wayland
    lookup="$gpu/firefox-gles:"
    export MOZ_ENABLE_WAYLAND=1
    # The Wayland DDK implements GLES. Match Firefox's context and symbol API.
    pref='user_pref("gfx.egl.prefer-gles.enabled", true);'
    if ! grep -Fqx "$pref" "$profile/user.js" 2>/dev/null; then
        printf '\n%s\n' "$pref" >> "$profile/user.js"
    fi
    # On AtlasA1 GNOME the per-window Wayland callback clock drops video
    # frames after decoding. Use Firefox's global clock; EGL/GLES and Cedar
    # remain accelerated. Validated on the board's 1080p60 output.
    pref='user_pref("widget.wayland.vsync.enabled", false);'
    if ! grep -Fqx "$pref" "$profile/user.js" 2>/dev/null; then
        printf '\n%s\n' "$pref" >> "$profile/user.js"
    fi
fi
# Only the panel-enabled package installs this marker and helper. Detect the
# physical mode at launch, never force a desktop resolution or affect X11.
# Explicit environment settings (including 0 to disable) take precedence.
if [ -z "${T736_CEDAR_BROWSER_PANEL+x}" ] && [ -r "$lib/browser-panel-enabled" ]; then
    panel=$(python3 /usr/lib/atlasa1/firefox_panel_mode.py 2>/dev/null) || panel=
    if [ "$panel" = 1920x1080 ]; then
        export T736_CEDAR_BROWSER_PANEL=$panel
    fi
fi
export LD_LIBRARY_PATH="$lib:${lookup}$gpu/runtime-gles${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_PRELOAD="$lib/libt736_cedar_client.so:$lib/libavcodec.so.62${LD_PRELOAD:+:$LD_PRELOAD}"
export LIBGL_DRIVERS_PATH="${LIBGL_DRIVERS_PATH:-$gpu/lib/dri}"
export MOZ_X11_EGL=1
if [ -n "${T736_CEDAR_PROFILE:-}" ]; then set -- --no-remote "$@"; fi
exec /usr/bin/firefox --profile "$profile" "$@"
