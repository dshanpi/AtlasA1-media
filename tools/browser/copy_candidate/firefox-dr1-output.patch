+typedef struct CedarImageTarget {
+    AVCodecContext *context;
+    AVFrame *frame;
+} CedarImageTarget;
+
+/* Invoked only for a validated frame, while the client protects its one SHM
+ * slot. No Firefox texture, AVFrame, or hardware handle crosses the socket. */
+static int copy_to_image(void *opaque, const struct t736_frame *picture,
+                         const uint8_t *pixels)
+{
+    CedarImageTarget *target = opaque;
+    AVCodecContext *context = target->context;
+    AVFrame *frame = target->frame;
+    if (picture->width != context->width || picture->height != context->height ||
+        picture->bytes_written != (size_t)context->width * context->height * 3 / 2)
+        return AVERROR(EPROTO);
+    frame->format = context->pix_fmt = AV_PIX_FMT_YUV420P;
+    int ret = ff_get_buffer(context, frame, 0);
+    if (ret < 0)
+        return ret;
+    for (unsigned plane = 0; plane < 3; plane++) {
+        unsigned width = picture->width >> (plane != 0);
+        unsigned height = picture->height >> (plane != 0);
+        int stride = frame->linesize[plane];
+        AVBufferRef *buffer = av_frame_get_plane_buffer(frame, plane);
+        if (!buffer || stride < (int)width)
+            return AVERROR(EPROTO);
+        size_t extent = (size_t)(height - 1) * stride + width;
+        uintptr_t offset = (uintptr_t)frame->data[plane] - (uintptr_t)buffer->data;
+        if (offset > buffer->size || extent > buffer->size - offset)
+            return AVERROR(EPROTO);
+        if ((unsigned)stride == width) {
+            memcpy(frame->data[plane], pixels, (size_t)width * height);
+        } else {
+            for (unsigned row = 0; row < height; row++)
+                memcpy(frame->data[plane] + (size_t)row * stride,
+                       pixels + (size_t)row * width, width);
+        }
+        pixels += (size_t)width * height;
+    }
+    return 0;
+}
