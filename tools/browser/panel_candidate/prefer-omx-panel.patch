+int t736_client_open_preferred_panel(int codec, unsigned width, unsigned height)
+{
+    const struct t736_open args = { (uint32_t)codec, width, height, T736_OPEN_PANEL1080 };
+    if (!t736_client_panel_requested() || (codec != T736_CODEC_HEVC && codec != T736_CODEC_H264) ||
+        width != 3840 || height != 2160) return -EINVAL;
+    int result = simple(T736_OPEN, 0, &args, sizeof(args), NULL, 0);
+    if (result > 0) {
+        fprintf(stderr, "T736_CEDAR_PANEL: session=%d mode=omx-scale input=3840x2160 shared=1920x1080 display=1920x1080\n", result);
+        return result;
+    }
+    /* EINVAL is the legacy OPEN flags check. ENOSPC also means a
+     * valid, retained full-size lease may be available on the new broker. */
+    if (result != -EINVAL && result != -ENOSPC)
+        return result;
+    int panel_error = result;
+    result = t736_client_open(codec, width, height);
+    if (result > 0)
+        fprintf(stderr, "T736_CEDAR_PANEL: session=%d mode=shm-box input=3840x2160 shared=3840x2160 display=1920x1080 panel_open=%d\n",
+                result, panel_error);
+    return result;
