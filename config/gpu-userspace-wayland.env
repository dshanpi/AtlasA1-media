# Load for the AtlasA1 GNOME Wayland session and its applications.
T736_IMG_ROOT=/opt/atlasa1-img-wayland
export LD_LIBRARY_PATH="$T736_IMG_ROOT/runtime-gles"
export LIBGL_DRIVERS_PATH="$T736_IMG_ROOT/lib/dri"
export COGL_DRIVER=gles2
export GDK_BACKEND=wayland GSK_RENDERER=gl GDK_DISABLE=gl-api,vulkan
unset VK_ICD_FILENAMES VK_DRIVER_FILES VK_ADD_DRIVER_FILES
unset LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER MESA_LOADER_DRIVER_OVERRIDE
unset LD_PRELOAD __EGL_VENDOR_LIBRARY_FILENAMES __GLX_VENDOR_LIBRARY_NAME
