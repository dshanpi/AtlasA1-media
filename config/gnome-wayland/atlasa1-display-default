#!/usr/bin/python3
"""Choose 1080p60 once for a new GNOME account, using its connected monitor."""
from pathlib import Path
import os
import sys
import tempfile
import time
import xml.etree.ElementTree as ET


def main():
    from gi.repository import Gio, GLib
    config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config')))
    dry_run = sys.argv[1:] == ['--dry-run']
    if (config / 'monitors.xml').exists() and not dry_run:
        return
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    def call(method, args=None):
        return bus.call_sync('org.gnome.Mutter.DisplayConfig',
                             '/org/gnome/Mutter/DisplayConfig',
                             'org.gnome.Mutter.DisplayConfig', method, args,
                             None, Gio.DBusCallFlags.NONE, 1500, None)

    for attempt in range(12):
        try:
            serial, monitors, logical, properties = call('GetCurrentState').unpack()
            if len(monitors) != 1 or len(logical) != 1:
                return
            spec, modes, _ = monitors[0]
            candidates = [m for m in modes if tuple(m[1:3]) == (1920, 1080) and 59 <= m[3] <= 61]
            if not candidates:
                return
            mode = min(candidates, key=lambda m: abs(m[3] - 60))
            props = {'layout-mode': GLib.Variant('u', properties.get('layout-mode', 1))}
            # Apply temporarily without GNOME's interactive keep/revert dialog.
            # Store this first-login default ourselves after a successful apply.
            args = GLib.Variant('(uua(iiduba(ssa{sv}))a{sv})',
                                (serial, 1, [(0, 0, 1.0, 0, True, [(spec[0], mode[0], {})])], props))
            if dry_run:
                print(args)
                return
            call('ApplyMonitorsConfig', args)
            document = ET.Element('monitors', version='2')
            configuration = ET.SubElement(document, 'configuration')
            ET.SubElement(configuration, 'layoutmode').text = 'logical' if properties.get('layout-mode', 1) == 1 else 'physical'
            logical_monitor = ET.SubElement(configuration, 'logicalmonitor')
            for name, value in [('x', '0'), ('y', '0'), ('scale', '1'), ('primary', 'yes')]:
                ET.SubElement(logical_monitor, name).text = value
            monitor = ET.SubElement(logical_monitor, 'monitor')
            monitor_spec = ET.SubElement(monitor, 'monitorspec')
            for name, value in zip(('connector', 'vendor', 'product', 'serial'), spec):
                ET.SubElement(monitor_spec, name).text = value
            monitor_mode = ET.SubElement(monitor, 'mode')
            for name, value in [('width', '1920'), ('height', '1080'), ('rate', f'{mode[3]:.3f}')]:
                ET.SubElement(monitor_mode, name).text = value
            config.mkdir(parents=True, exist_ok=True)
            with tempfile.NamedTemporaryFile(dir=config, prefix='.atlas-monitor-', delete=False) as stream:
                temporary = Path(stream.name)
                stream.write(ET.tostring(document, encoding='utf-8') + b'\n')
            try:
                # Never overwrite a configuration saved concurrently by the user.
                os.link(temporary, config / 'monitors.xml')
            except FileExistsError:
                pass
            finally:
                temporary.unlink()
            return
        except GLib.Error as error:
            if attempt == 11:
                print(f'AtlasA1 display default: {error}', file=sys.stderr)
                return
            time.sleep(1)


if __name__ == '__main__':
    main()
